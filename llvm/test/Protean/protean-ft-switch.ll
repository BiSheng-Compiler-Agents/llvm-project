; REQUIRES: ACPO_AOT
; REQUIRES: asserts
; RUN: env BISHENG_ACPO_DIR=%S/../../../acpo protean -protean \
; RUN:   -debug-only=protean,ir2score --max-iterations=1 --use-protean-collect=false \
; RUN:   -o %t.ir2vec.bc %s >%t.ir2vec.log 2>&1
; RUN: FileCheck %s --check-prefixes=IR2VEC,COMMON < %t.ir2vec.log
; RUN: env BISHENG_ACPO_DIR=%S/../../../acpo protean -protean \
; RUN:   -debug-only=protean,ir2score --max-iterations=1 --use-protean-collect=true \
; RUN:   -o %t.protean.bc %s >%t.protean.log 2>&1
; RUN: FileCheck %s --check-prefixes=PROTEAN,COMMON < %t.protean.log

; IR2VEC: Loading IR2SCOREIR2VEC Model
; PROTEAN: Loading IR2SCOREPROTEAN Model
; COMMON: Found IRScore:
; COMMON: Score is generated by the ML model successfully!
; COMMON: Finished SA

@a = global i32 4

declare void @extern()
; Function Attrs: nounwind readnone uwtable
define i32 @simpleFunction(i32 %a) #1 {
entry:
  call void @extern()
  %a1 = load volatile i32, i32* @a
  %x1 = add i32 %a1,  %a1
  %a2 = load volatile i32, i32* @a
  %x2 = add i32 %x1, %a2
  %a3 = load volatile i32, i32* @a
  %x3 = add i32 %x2, %a3
  %a4 = load volatile i32, i32* @a
  %x4 = add i32 %x3, %a4
  %a5 = load volatile i32, i32* @a
  %x5 = add i32 %x4, %a5
  %a6 = load volatile i32, i32* @a
  %x6 = add i32 %x5, %a6
  %a7 = load volatile i32, i32* @a
  %x7 = add i32 %x6, %a6
  %a8 = load volatile i32, i32* @a
  %x8 = add i32 %x7, %a8
  %a9 = load volatile i32, i32* @a
  %x9 = add i32 %x8, %a9
  %a10 = load volatile i32, i32* @a
  %x10 = add i32 %x9, %a10
  %a11 = load volatile i32, i32* @a
  %x11 = add i32 %x10, %a11
  %a12 = load volatile i32, i32* @a
  %x12 = add i32 %x11, %a12
  %add = add i32 %x12, %a
  ret i32 %add
}

define i32 @bar(i32 %a) #0 {
entry:
  %0 = tail call i32 @simpleFunction(i32 6)
  ret i32 %0
}

attributes #0 = { nounwind readnone uwtable }
attributes #1 = { nounwind cold readnone uwtable }
